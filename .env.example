# ---- Frontend (aman untuk browser: anon/publishable key dilindungi RLS) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Opsional: subpath hosting (mis. GitHub Pages /repo-name)
NEXT_PUBLIC_BASE_PATH=

# ---- Edge Function secrets (JANGAN taruh di frontend; set via `supabase secrets set`) ----
# MARKET_PROVIDER=twelvedata | binance_paxg | demo
# TWELVEDATA_API_KEY=...
# ENGINE_SECRET=random-string-yang-sama-dengan-vault.secrets('engine_secret')
